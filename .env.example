# URL reachable by the browser, including /api. Use public HTTPS in production.
# Example: VITE_API_URL=https://api.example.com/api
VITE_API_URL=http://localhost:4001/api
# Published Docker Compose port; Nginx listens on port 80 inside the container.
ADMIN_PORT=8080
# Do not put ADMIN_API_KEY here. Enter it in the admin connection panel.
